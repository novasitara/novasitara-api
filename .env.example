# PostgreSQL. Use a direct (non-pooled) connection so migrations work.
DATABASE_URL=postgresql://novasitara:password@localhost:5432/novasitara

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

PORT=3000
# Uploaded images (storage/public) and CVs (storage/resumes, never public)
STORAGE_DIR=./storage

# Email notifications for enquiries and applications. Leave SMTP_HOST empty to skip sending.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@novasitara.com
SMTP_PASS=
SMTP_FROM="Nova Sitara Website <noreply@novasitara.com>"
MAIL_TO=info@novasitara.com
# Link to the admin panel in notification emails
ADMIN_URL=https://admin.novasitara.com
